<?xml version="1.0" encoding="UTF-8"?>
<!--
    Integration test mode: runs only the `integration` Pest group against the real MySQL and
    Redis services from compose.yaml. Run it with `composer test:integration` (it executes inside
    the `app` container). The database name comes from DB_TEST_DATABASE (`${DB_DATABASE}_testing`,
    set by compose.yaml): tests/integration-bootstrap.php points DB_DATABASE at it and refuses
    to run without it, so development data is never touched.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/integration-bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Integration">
            <directory>tests/Unit</directory>
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <groups>
        <include>
            <group>integration</group>
        </include>
    </groups>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="redis" force="true"/>
        <env name="CACHE_PREFIX" value="testing-cache-" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="REDIS_DB" value="14" force="true"/>
        <env name="REDIS_CACHE_DB" value="15" force="true"/>
        <env name="REDIS_PREFIX" value="testing-" force="true"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
